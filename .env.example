# Google Analytics 4 Measurement ID.
#
# Read at BUILD time only, by scripts/build-analytics-config.js, which
# writes js/analytics-config.js. It is never read by the browser directly.
#
# GA is only switched on when VERCEL_ENV=production, so setting this
# locally or on a preview deployment will not send any data. Set it in
# Vercel under Settings -> Environment Variables, scoped to Production.
GA_MEASUREMENT_ID=G-XXXXXXXXXX
